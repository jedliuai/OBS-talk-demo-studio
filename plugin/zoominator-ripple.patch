+void ZoominatorController::updateEnhancedCursorPosition(obs_scene_t *scene, double x, double y)
+{
+	obs_sceneitem_t *item = ensureEnhancedCursorItem(scene);
+	if (!item)
+		return;
+
+	/* ~60ms of critically damped smoothing irons out jitter and stair-stepped
+	 * mouse reports. Jumps (re-entry, scene switch) snap. Click feedback uses
+	 * the real click coordinates, never this smoothed point. */
+	const qint64 nowMs = QDateTime::currentMSecsSinceEpoch();
+	const double dt = (double)(nowMs - cursorSmoothLastMs) / 1000.0;
+	const double jump = std::hypot(x - cursorSmoothX, y - cursorSmoothY);
+	if (!cursorSmoothValid || dt > 0.25 || jump > 400.0 * overlay_pixel_scale()) {
+		cursorSmoothX = x;
+		cursorSmoothY = y;
+		cursorVelX = 0.0;
+		cursorVelY = 0.0;
+		cursorSmoothValid = true;
+	} else if (dt > 0.0) {
+		const double omega = 4000.0 / kCursorSmoothMs;
+		auto step = [&](double &pos, double &vel, double goal) {
+			const double e0 = pos - goal;
+			const double c = vel + omega * e0;
+			const double decay = std::exp(-omega * dt);
+			pos = goal + (e0 + c * dt) * decay;
+			vel = (vel - omega * c * dt) * decay;
+		};
+		step(cursorSmoothX, cursorVelX, x);
+		step(cursorSmoothY, cursorVelY, y);
+	}
+	cursorSmoothLastMs = nowMs;
+
+	const double scale = pointerPressScale(nowMs);
+	normalize_cursor_scene_item(item, (float)scale);
+	vec2 pos{};
+	pos.x = (float)(cursorSmoothX - (double)enhancedCursorTipX * scale);
+	pos.y = (float)(cursorSmoothY - (double)enhancedCursorTipY * scale);
+	obs_sceneitem_set_pos(item, &pos);
+	if (!obs_sceneitem_visible(item))
+		obs_sceneitem_set_visible(item, true);
+	obs_sceneitem_set_order(item, OBS_ORDER_MOVE_TOP);
+}
