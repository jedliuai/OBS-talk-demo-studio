+/* Paint at 4x and filter down so diagonals and curves keep clean edges. */
+template<typename PaintFn> static QImage render_supersampled(int w, int h, PaintFn &&paint)
+{
+	constexpr int kSupersample = 4;
+	QImage big(w * kSupersample, h * kSupersample, QImage::Format_ARGB32_Premultiplied);
+	big.fill(Qt::transparent);
+	{
+		QPainter painter(&big);
+		painter.setRenderHint(QPainter::Antialiasing, true);
+		painter.scale(kSupersample, kSupersample);
+		paint(painter);
+	}
+	return big.scaled(w, h, Qt::IgnoreAspectRatio, Qt::SmoothTransformation)
+		.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+}
