+/* Three box passes approximate a gaussian; radius r gives sigma ~ sqrt(r(r+1)). */
+static void box_blur(QImage &img, int radius)
+{
+	if (radius <= 0 || img.isNull())
+		return;
+	const int w = img.width();
+	const int h = img.height();
+	const int n = radius * 2 + 1;
+	std::vector<QRgb> line((size_t)std::max(w, h));
+	auto pass = [&](bool horizontal) {
+		const int lines = horizontal ? h : w;
+		const int len = horizontal ? w : h;
+		for (int l = 0; l < lines; ++l) {
+			auto px = [&](int i) -> QRgb & {
+				return horizontal ? reinterpret_cast<QRgb *>(img.scanLine(l))[i]
+						  : reinterpret_cast<QRgb *>(img.scanLine(i))[l];
+			};
+			for (int i = 0; i < len; ++i) {
+				int a = 0, r = 0, g = 0, b = 0;
+				for (int k = -radius; k <= radius; ++k) {
+					const int j = i + k;
+					if (j < 0 || j >= len)
+						continue;
+					const QRgb c = px(j);
+					a += qAlpha(c);
+					r += qRed(c);
+					g += qGreen(c);
+					b += qBlue(c);
+				}
+				line[(size_t)i] = qRgba(r / n, g / n, b / n, a / n);
+			}
+			for (int i = 0; i < len; ++i)
+				px(i) = line[(size_t)i];
+		}
+	};
+	for (int i = 0; i < 3; ++i) {
+		pass(true);
+		pass(false);
+	}
+}
