+/* Press: shrink to 0.86 within 60ms. Release: spring back over 180ms with a
+ * slight overshoot to 1.06. */
+double ZoominatorController::pointerPressScale(qint64 nowMs)
+{
+	bool down = false;
+	qint64 downMs = 0, upMs = 0;
+	{
+		std::lock_guard<std::mutex> lock(inputMutex);
+		down = pointerDown;
+		downMs = pointerDownMs;
+		upMs = pointerUpMs;
+	}
+
+	auto pressed = [](double heldMs) {
+		return 1.0 + (kCursorPressScale - 1.0) * ease_out_cubic(heldMs / kCursorPressMs);
+	};
+	if (down)
+		return pressed((double)(nowMs - downMs));
+	if (downMs <= 0 || upMs <= 0)
+		return 1.0;
+
+	const double t = (double)(nowMs - upMs);
+	if (t >= kCursorReleaseMs)
+		return 1.0;
+	const double from = pressed((double)(upMs - downMs));
+	if (t < kCursorOvershootMs)
+		return from + (kCursorOvershootScale - from) * ease_out_cubic(t / kCursorOvershootMs);
+	return kCursorOvershootScale +
+	       (1.0 - kCursorOvershootScale) *
+		       smoothstep((t - kCursorOvershootMs) / (kCursorReleaseMs - kCursorOvershootMs));
+}
