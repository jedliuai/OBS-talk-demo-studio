+obs_sceneitem_t *ZoominatorController::ensureEnhancedCursorItem(obs_scene_t *scene)
+{
+	if (!scene)
+		return nullptr;
+	ensureEnhancedCursorSource();
+	if (!enhancedCursorSource)
+		return nullptr;
+
+	struct Finder {
+		obs_source_t *want = nullptr;
+		obs_sceneitem_t *found = nullptr;
+		static bool enum_cb(obs_scene_t *, obs_sceneitem_t *item, void *param)
+		{
+			auto *finder = static_cast<Finder *>(param);
+			if (!finder || finder->found)
+				return false;
+			if (obs_sceneitem_get_source(item) == finder->want) {
+				finder->found = item;
+				return false;
+			}
+			return true;
+		}
+	};
+
+	Finder finder{enhancedCursorSource, nullptr};
+	obs_scene_enum_items(scene, Finder::enum_cb, &finder);
+	if (finder.found) {
+		normalize_marker_scene_item(finder.found);
+		return finder.found;
+	}
+
+	obs_sceneitem_t *item = obs_scene_add(scene, enhancedCursorSource);
+	if (item)
+		normalize_marker_scene_item(item);
+	return item;
+}
+
+void ZoominatorController::hideEnhancedCursorInScene(obs_scene_t *scene)
+{
+	if (!scene || !enhancedCursorSource)
+		return;
+
+	struct Finder {
+		obs_source_t *want = nullptr;
+		static bool enum_cb(obs_scene_t *, obs_sceneitem_t *item, void *param)
+		{
+			auto *want = static_cast<obs_source_t **>(param);
+			if (want && obs_sceneitem_get_source(item) == *want) {
+				obs_sceneitem_set_visible(item, false);
+				return false;
+			}
+			return true;
+		}
+	};
+	obs_source_t *want = enhancedCursorSource;
+	obs_scene_enum_items(scene, Finder::enum_cb, &want);
+}
+
+void ZoominatorController::updateEnhancedCursorPosition(obs_scene_t *scene, double x, double y)
+{
+	obs_sceneitem_t *item = ensureEnhancedCursorItem(scene);
+	if (!item)
+		return;
+	normalize_marker_scene_item(item);
+	vec2 pos{};
+	pos.x = (float)x;
+	pos.y = (float)y;
+	obs_sceneitem_set_pos(item, &pos);
+	if (!obs_sceneitem_visible(item))
+		obs_sceneitem_set_visible(item, true);
+	obs_sceneitem_set_order(item, OBS_ORDER_MOVE_TOP);
+}
