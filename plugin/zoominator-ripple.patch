+static bool match_capture_rect_for_source(obs_source_t *src, int &x, int &y, int &w, int &h)
+{
+	if (!src)
+		return false;
+
+#ifdef _WIN32
+	RECT rc{};
+	if (!match_window_rect_for_source(src, rc) && !match_monitor_rect(src, rc))
+		return false;
+	rc = native_rect_to_qt_logical(rc);
+	x = rc.left;
+	y = rc.top;
+	w = rc.right - rc.left;
+	h = rc.bottom - rc.top;
+#elif defined(__APPLE__)
+	CGRect rc{};
+	if (!match_window_rect_for_source(src, rc) && !match_monitor_rect(src, rc))
+		return false;
+	x = (int)std::lround(rc.origin.x);
+	y = (int)std::lround(rc.origin.y);
+	w = (int)std::lround(rc.size.width);
+	h = (int)std::lround(rc.size.height);
+#elif defined(__linux__)
+	LinuxRect rc{};
+	if (!match_window_rect_for_source(src, rc) && !match_monitor_rect(src, rc))
+		return false;
+	x = rc.x;
+	y = rc.y;
+	w = rc.w;
+	h = rc.h;
+#else
+	return false;
+#endif
+
+	return w > 0 && h > 0;
+}
