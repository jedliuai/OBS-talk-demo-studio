+void ZoominatorController::ensureEnhancedCursorSource()
+{
+	if (enhancedCursorSource)
+		return;
+
+	rebuildEnhancedCursorImage();
+	const QString path = enhancedCursorImagePath();
+	if (path.isEmpty())
+		return;
+
+	obs_data_t *settings = obs_data_create();
+	obs_data_set_string(settings, "file", path.toUtf8().constData());
+	obs_data_set_bool(settings, "unload", false);
+	enhancedCursorSource = obs_source_create_private("image_source", kZoominatorEnhancedCursorSourceName, settings);
+	obs_data_release(settings);
+}
