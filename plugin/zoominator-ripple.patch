+/* Classic arrow silhouette in units of a 1x system arrow; the tip is (0, 0). */
+static QPainterPath cursor_arrow_path(double unit)
+{
+	static const QPointF points[] = {{0.0, 0.0},  {0.0, 16.0},  {3.9, 12.3}, {6.4, 18.2},
+					 {8.9, 17.1}, {6.4, 11.4}, {11.6, 11.4}};
+	QPainterPath path;
+	path.moveTo(points[0] * unit);
+	for (size_t i = 1; i < sizeof(points) / sizeof(points[0]); ++i)
+		path.lineTo(points[i] * unit);
+	path.closeSubpath();
+	return path;
+}
