+void ZoominatorController::notifyPointerButton(bool down)
+{
+	const qint64 nowMs = QDateTime::currentMSecsSinceEpoch();
+	std::lock_guard<std::mutex> lock(inputMutex);
+	if (down) {
+		pointerDown = true;
+		pointerDownMs = nowMs;
+	} else if (pointerDown) {
+		pointerDown = false;
+		pointerUpMs = nowMs;
+	}
+}
