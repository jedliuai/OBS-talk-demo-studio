+static bool qt_screen_mapping_for_monitor(HMONITOR monitor, RECT &nativeMonitor, QRect &logicalMonitor, double &dpr)
+{
+	MONITORINFOEXW info{};
+	info.cbSize = sizeof(info);
+	if (!monitor || !GetMonitorInfoW(monitor, &info))
+		return false;
+
+	QScreen *match = nullptr;
+	const QString deviceName = QString::fromWCharArray(info.szDevice);
+	for (auto *screen : QGuiApplication::screens()) {
+		if (screen && screen->name().compare(deviceName, Qt::CaseInsensitive) == 0) {
+			match = screen;
+			break;
+		}
+	}
+	if (!match && QGuiApplication::screens().size() == 1)
+		match = QGuiApplication::primaryScreen();
+	if (!match)
+		return false;
+
+	nativeMonitor = info.rcMonitor;
+	logicalMonitor = match->geometry();
+	dpr = std::max(0.1, (double)match->devicePixelRatio());
+	return true;
+}
+
+static RECT native_rect_to_qt_logical(const RECT &nativeRect)
+{
+	RECT nativeMonitor{};
+	QRect logicalMonitor;
+	double dpr = 1.0;
+	RECT out = nativeRect;
+	HMONITOR monitor = MonitorFromRect(&nativeRect, MONITOR_DEFAULTTONEAREST);
+	if (!qt_screen_mapping_for_monitor(monitor, nativeMonitor, logicalMonitor, dpr))
+		return out;
+
+	out.left = logicalMonitor.left() + (LONG)std::lround((nativeRect.left - nativeMonitor.left) / dpr);
+	out.top = logicalMonitor.top() + (LONG)std::lround((nativeRect.top - nativeMonitor.top) / dpr);
+	out.right = logicalMonitor.left() + (LONG)std::lround((nativeRect.right - nativeMonitor.left) / dpr);
+	out.bottom = logicalMonitor.top() + (LONG)std::lround((nativeRect.bottom - nativeMonitor.top) / dpr);
+	return out;
+}
+
+static POINT native_point_to_qt_logical(const POINT &nativePoint)
+{
+	RECT pointRect{nativePoint.x, nativePoint.y, nativePoint.x + 1, nativePoint.y + 1};
+	const RECT mapped = native_rect_to_qt_logical(pointRect);
+	return POINT{mapped.left, mapped.top};
+}
